{
  "name": "@lemoe-technology/eslint-config",
  "version": "1.1.0",
  "description": "Lemoe Technology's ESLint config",
  "homepage": "https://github.com/lemoe-technology/eslint-config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemoe-technology/eslint-config.git"
  },
  "license": "MIT",
  "author": "Lemoe",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "prepare": "simple-git-hooks",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "pre-push": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "lint-staged": {
    "*": "eslint --fix --no-warn-ignored"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint-config-flat-gitignore": "^2.4.0",
    "eslint-merge-processors": "^2.0.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-import-lite": "^0.6.0",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-n": "^18.4.0",
    "eslint-plugin-package-json": "^1.10.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "eslint-plugin-toml": "^1.5.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-yml": "^3.8.1",
    "eslint-processor-vue-blocks": "^2.0.0",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.1",
    "vue-eslint-parser": "^10.4.1"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "@stylistic/eslint-plugin": "^5.0.0",
    "eslint": "^10.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
